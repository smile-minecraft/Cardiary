    "boardsDeleteConfirmBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the arrangement is deleted. The cards themselves are kept. This cannot be undone."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只會刪除白板上的排列，卡片本身不受影響。此動作無法復原。"
          }
        }
      }
    },
