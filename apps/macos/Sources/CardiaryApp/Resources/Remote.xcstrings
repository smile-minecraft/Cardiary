    "remotePairingApprove": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approve"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "核准"
          }
        }
      }
    },
    "remotePairingApproved": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approved. The device can claim its token."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已核准，裝置可以領取憑證。"
          }
        }
      }
    },
    "remotePairingBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check that the code on the device matches the one below before deciding."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確認裝置上顯示的短碼與下面相同，再決定是否核准。"
          }
        }
      }
    },
    "remotePairingCode": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
