    "remoteDevicesRevoke": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Revoke device"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "撤銷裝置"
          }
        }
      }
    },
    "remoteDevicesRevokeConfirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Revoke this device? It loses its connection immediately and must pair again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "撤銷這台裝置？它會立即失去連線，必須重新配對。"
          }
        }
      }
    },
    "remoteDevicesRevokeFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not revoke: {value}"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "撤銷失敗：{value}"
          }
        }
      }
    },
    "remoteDevicesRevoked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Revoked"
          }
        },
