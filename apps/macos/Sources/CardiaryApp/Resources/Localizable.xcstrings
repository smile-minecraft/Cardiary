    "approvalAlwaysHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The host decides the scope; later requests in that scope are allowed without asking."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "範圍由主機決定；之後符合這個範圍的請求會直接放行。"
          }
        }
      }
    },
