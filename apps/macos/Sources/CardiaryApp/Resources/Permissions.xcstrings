{
  "sourceLanguage": "en",
  "strings": {
    "permSystemOneTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System One review"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "System One 代為審核"
          }
        }
      }
    },
    "permSystemOneBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For the categories you turn on, System One approves on your behalf when the action matches the current task and nothing looks suspicious. Everything else still asks you."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟的類別裡，System One 判斷動作和目前的工作一致、沒有可疑意圖時，會代你放行；其他一律問你。"
          }
        }
      }
    },
    "permCategoryReadOnlyFiles": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read files in chosen folders"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讀取授權資料夾內的檔案"
          }
        }
      }
    },
    "permCategoryGitReadonly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read-only git commands"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "唯讀的 git 指令"
          }
        }
      }
    },
    "permCategoryCreateCard": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create cards or notes"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "建立卡片或筆記"
          }
        }
      }
    },
    "permCategoryOwnNotification": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
