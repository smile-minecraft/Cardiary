          }
        }
      }
    },
    "mcpAllowedHostsHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only these hosts are allowed; the URL's own host is always included."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有這些網域會被允許；網址本身的網域一定會加入。"
          }
        }
      }
    },
