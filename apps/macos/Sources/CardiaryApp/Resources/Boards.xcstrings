      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The board changed elsewhere; the latest version is loaded. Your changes are not saved."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "白板在別處被改過，已載入最新版本。你的變更尚未存回。"
