{
  "sourceLanguage": "en",
  "strings": {
    "remoteAccessUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not connected; remote access needs a service connection."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒連上服務，遠端存取需要連線。"
          }
        }
      }
    },
    "remoteDevicesEmpty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No paired devices yet."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有已配對的裝置。"
          }
        }
      }
    },
