{
  "name": "cardiary",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "check": "pnpm lint && pnpm format && pnpm build && pnpm test",
    "test:swift": "swift test --package-path apple/CardiaryKit && swift test --package-path apps/macos",
    "test:contract:pi": "CARDIARY_CONTRACT_ENGINE=pi vitest run packages/contract-tests",
    "test:removable-disk": "CARDIARY_HDIUTIL_TESTS=1 vitest run packages/host/test/removable-disk.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
