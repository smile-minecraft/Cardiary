    "archiveDeleteConfirmBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This immediately deletes the conversation and its exclusive cards. Shared cards and still-referenced assets are kept."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會立即刪除對話與專屬卡片，無法復原；共用卡片與仍被引用的原檔會保留。"
          }
        }
      }
    },
