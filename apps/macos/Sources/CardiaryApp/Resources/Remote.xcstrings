      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device revoked."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已撤銷裝置。"
          }
        }
      }
    },
