    "mcpServiceUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MCP settings need a service connection."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒連上服務，MCP 設定需要連線。"
          }
        }
      }
    },
    "mcpEmpty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No MCP servers yet. Add one so agents can use its tools."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有 MCP 伺服器。新增一個，代理就能使用它的工具。"
          }
        }
      }
    },
    "mcpWaitingApproval": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for approval"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等待審批"
          }
        }
      }
    },
    "mcpApprovalSubmitted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sent for approval. The server starts only after it is approved."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已送出審批。批准之後才會啟動伺服器。"
          }
        }
      }
    },
    "mcpApprovalNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New servers need approval; until then they do not start and agents cannot use their tools."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增伺服器要經審批；批准前不會啟動，代理也不能使用它的工具。"
          }
        }
      }
    },
    "mcpAdded": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server added."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器已加入。"
          }
        }
      }
    },
    "mcpRemove": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
