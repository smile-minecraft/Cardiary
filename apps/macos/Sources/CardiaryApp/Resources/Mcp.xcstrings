{
  "sourceLanguage": "en",
  "strings": {
    "mcpServersTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MCP Servers"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "MCP 伺服器"
          }
        }
      }
    },
    "mcpServersHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect external tools over stdio or HTTP. Secrets and environment variables stay on the host and are never shown here."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以標準輸入或 HTTP 連上外部工具。密鑰與環境變數留在主機，畫面不會顯示。"
          }
        }
      }
    },
    "mcpAdd": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add server"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增伺服器"
          }
        }
      }
    },
