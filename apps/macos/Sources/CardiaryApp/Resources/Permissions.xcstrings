    "permNeedsFolder": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add at least one folder first."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先加入至少一個資料夾。"
          }
        }
      }
    },
    "permDomainsTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Domains it may read"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可代為讀取的網域"
          }
        }
      }
    },
    "permDomainsBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System One may only send HTTP GET requests to these domains. One per line; localhost and private networks are not allowed."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "System One 只能對這些網域發 HTTP GET。每行一個；localhost 與私有網段不能加入。"
          }
        }
      }
    },
    "permDomainsSave": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save domains"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存網域"
          }
        }
      }
    },
    "permAllowAllTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow all"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "全部允許"
          }
        }
      }
    },
    "permAllowAllBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stops asking for the chosen tools inside the chosen folders until you end it, including across restarts. Forbidden actions, permission settings, keys and credentials, and sending messages out are never included. Emergency pause ends it immediately."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在選定的工具與資料夾內不再詢問，重啟後仍保留，直到手動結束。禁止項、權限設定、金鑰與憑證、對外送訊息永遠不包含在內。按下緊急全部暫停會立刻結束。"
          }
        }
      }
    },
    "permToolRead": {
      "extractionState": "manual",
      "localizations": {
